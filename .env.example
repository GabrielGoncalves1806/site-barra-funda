# Hash bcrypt da senha do admin. Gere com:
#   python scripts/generate_password_hash.py <sua-senha>
ADMIN_PASSWORD_HASH=

# Chave para assinatura de tokens (gere com `python -c "import secrets; print(secrets.token_urlsafe(48))"`)
SECRET_KEY=

# Domínios permitidos para CORS, separados por vírgula
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Cookie de sessão só é enviado em HTTPS quando true. Use "true" em produção
# (com TLS configurado) e "false" em desenvolvimento local sem HTTPS.
COOKIE_SECURE=false

# Opcional: URL do banco. Sem ela, usa o SQLite em ./data.db (bom pra dev local).
# Produção usa o Postgres do Neon: cole a connection string *pooled* (host
# com "-pooler") do jeito que o Neon entrega, com postgresql:// mesmo.
# DATABASE_URL=postgresql://user:senha@ep-xxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
